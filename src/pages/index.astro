---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Fetch and sort all posts
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

// Filter posts by primary tags for the split layout
const softwareSolutions = sortedPosts
  .filter(({ data }) => data.tags.includes("Software Solutions"))
  .slice(0, postsConfig.perIndex);

const epcProjects = sortedPosts
  .filter(({ data }) => data.tags.includes("EPC Projects"))
  .slice(0, postsConfig.perIndex);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        M.Akbarzadeh
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={0}
          height={0}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      <p>
        <strong>Mechanical/Piping Engineer</strong> <br>
        <strong>Plant Design Automation Developer</strong>
      </p>
      <p>
        Read my technical teardowns and engineering experiences below, or visit my <strong><a href="/about">(About Page)</a></strong> for consulting details.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      softwareSolutions.length > 0 && (
        <section
          id="software-solutions"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": epcProjects.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Software Solutions
          </h2>
          <p class="mb-4 text-sm opacity-80">Plant Design Automation tools, PML/C# Macros, and AI Integration</p>
          <ul>
            {softwareSolutions.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      epcProjects.length > 0 && (
        <section id="epc-projects" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            EPC Engineering Experience
          </h2>
          <p class="mb-4 text-sm opacity-80">Plant Design Projects and Mechanical/Piping Engineering Experience </p>
          <ul>
            {epcProjects.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>